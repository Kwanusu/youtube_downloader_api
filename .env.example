# --- Zoho (ADMIN account, so every mentor's recordings are visible) ---
ZOHO_DOMAIN=zoho.com
ZOHO_ZSOID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Only if Zoho returns 404 on the default root, e.g. https://meeting.zoho.com/meeting/api/v2
# ZOHO_API_BASE=

# --- YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_TOKEN_FILE=/opt/class-uploader/token.json
YOUTUBE_PRIVACY=unlisted

# --- Zindua LMS (Rukia API) ---
# Use a Zitadel machine user that is an admin member of the organisation.
LMS_API_BASE_URL=https://api.rukialabs.com
LMS_ORG_ID=
LMS_TOKEN_URL=https://auth.rukialabs.com/oauth/v2/token
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=
LMS_SCOPE=openid urn:zitadel:iam:org:project:id:<PROJECT_ID>:aud
# Or, instead of client credentials, a personal access token:
# LMS_ACCESS_TOKEN=

# --- Class schedule (Africa/Nairobi) ---
TIMEZONE=Africa/Nairobi
FULL_TIME_HOURS=09:00-14:00
PART_TIME_HOURS=19:00-22:00
MATCH_TOLERANCE_MINUTES=45

# --- Service ---
DATA_DIR=/opt/class-uploader/data
POLL_INTERVAL_SECONDS=900
MAX_ATTEMPTS=5
HOST=127.0.0.1
PORT=8080
# Long random strings, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
DASHBOARD_USER=mentor
DASHBOARD_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Failure alerts (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
